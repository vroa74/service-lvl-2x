# LÍNEAS ESPECÍFICAS PARA REEMPLAZAR EN EL ARCHIVO .env
# Busca estas líneas en tu archivo .env y reemplázalas:

MAIL_MAILER=smtp
MAIL_HOST=smtp.ionos.mx
MAIL_PORT=587
MAIL_USERNAME=tu_email@tu_dominio.com
MAIL_PASSWORD=tu_contraseña_email
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="tu_email@tu_dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# INSTRUCCIONES:
# 1. Abre el archivo .env con un editor de texto
# 2. Busca las líneas que empiezan con MAIL_
# 3. Reemplaza esas líneas con las de arriba
# 4. Cambia "tu_email@tu_dominio.com" por tu email real
# 5. Cambia "tu_contraseña_email" por tu contraseña real
# 6. Guarda el archivo

# EJEMPLO DE CONFIGURACIÓN COMPLETA:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.ionos.mx
# MAIL_PORT=587
# MAIL_USERNAME=admin@legislatura.campeche.gob.mx
# MAIL_PASSWORD=MiContraseña123
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="admin@legislatura.campeche.gob.mx"
# MAIL_FROM_NAME="${APP_NAME}"
